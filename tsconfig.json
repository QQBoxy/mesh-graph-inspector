{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "moduleResolution": "Bundler", "skipLibCheck": true, "isolatedModules": true,
    "noEmit": true, "strict": true, "noUnusedLocals": true, "noUnusedParameters": true,
    "resolveJsonModule": true
  },
  "include": ["src", "tests", "vite.config.ts"]
}
